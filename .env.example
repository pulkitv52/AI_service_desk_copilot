# Application Environment Configuration

# Gemini LLM & Embeddings
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
RAG_SIMILARITY_THRESHOLD=0.60

# ServiceNow Integration (Personal Developer Instance)
USE_MOCK_SERVICENOW=true
SERVICENOW_INSTANCE_URL=https://devXXXXX.service-now.com
SERVICENOW_USERNAME=svc_service_desk
SERVICENOW_PASSWORD=
SERVICENOW_TIMEOUT_SECONDS=10.0

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_DB=service_desk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/service_desk

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Incident routing: use actual active sys_ids from your PDI.
SERVICENOW_CALLER_SYS_ID=
SERVICENOW_FALLBACK_GROUP_SYS_ID=
# JSON object from logical routing names to PDI group sys_ids.
SERVICENOW_GROUP_IDS={}
# Example names: Network Support, Identity & Access Support, SAP Support,
# Collaboration Support, End User Computing. Missing groups use the fallback.
